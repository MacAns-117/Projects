# Copy this file to .env and fill in your actual key. Never commit .env.

# --- LLM provider (default: Groq) ---
# Get your free key at https://console.groq.com/
GROQ_API_KEY=gsk_YOUR_KEY_HERE
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b      # optional override for Groq

# --- Or: any OpenAI-compatible local server (llama.cpp / Ollama / LM Studio) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:8080/v1   # Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1
# LLM_MODEL=my-model                       # required in this mode; GET $LLM_BASE_URL/models lists names
# LLM_API_KEY=                              # optional; local servers usually ignore it
# LLM_MAX_TOKENS=8192                       # optional; raise for "thinking" models
# LLM_TIMEOUT=600                           # optional, seconds (default 300)

# Optional: force cross-encoder rerank on/off (default = on if model loads)
# RAG_RERANK=1
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_RERANK_CANDIDATES=20
# RAG_CE_MIN_SCORE=-9.0
# RAG_MIN_TOP_SCORE=0.32

# Faithfulness judge (python -m eval.run_faithfulness) reuses the LLM_* settings
# above. Judge-only overrides, if you want a different judge endpoint/model:
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=local
# JUDGE_MODEL=my-judge-model
