# Copy this file to .env and fill in your actual key
# Get your free key at https://console.groq.com/
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# Optional: force cross-encoder rerank on/off (default = on if model loads)
# RAG_RERANK=1
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_RERANK_CANDIDATES=20
# RAG_CE_MIN_SCORE=-9.0
# RAG_MIN_TOP_SCORE=0.32

# Faithfulness judge — any OpenAI-compatible endpoint (Groq or local llama.cpp).
# Do not commit real keys. Not required for pytest or retrieval eval.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_YOUR_KEY_HERE
# JUDGE_MODEL=openai/gpt-oss-120b
# Or local:
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=local
# JUDGE_MODEL=local-model
